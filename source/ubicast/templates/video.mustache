{{!
    @template mediatimesrc_ubicast/video

    This template will render a resource to embed in library

    Variables required for this template:
    * elementid - Element id for the video element
    * instance - JSON options for the Video Time player

    Variables optional for this template:
    * classes - CSS classes for the container
    * poster - Thumbnail url
    * title - Media title
    * videourl - HLS playlist url, empty while Nudgis processes the video

    Example context (json):
    {
        "elementid": "a3lj4l3j4",
        "poster": "https://example.com/thumbnails/videos/v1234/thumb_medium.jpg",
        "title": "Ducks",
        "instance": "{}",
        "videourl": "https://example.com/pluginfile.php/1/mediatimesrc_ubicast/playlist/9/v1234.m3u8"
    }

}}
<div class="col col-12 {{ classes }} text-center">
    {{# videourl }}
    <video
        id="{{ elementid }}"
        controls
        poster="{{ poster }}"
        class="video-js col col-12"
    >
    </video>
    {{/ videourl }}
    {{^ videourl }}
    <div class="alert alert-info">
        {{# str }} processingmessage, mediatimesrc_ubicast {{/ str }}
    </div>
    <img src="{{ poster }}" class="col col-12 {{ classes }}" alt="{{ title }}">
    {{/ videourl }}
</div>
{{#js}}
if (document.getElementById('{{ elementid }}')) {
    require(['videotimeplugin_videojs/videotime'], function(VideoTime) {
        VideoTime.prototype.view = function() {
            return true;
        };
        var v = new VideoTime('{{{ elementid }}}', 0, 0, 0, {{{instance}}});
        v.initialize();
    });
}
{{/js}}
